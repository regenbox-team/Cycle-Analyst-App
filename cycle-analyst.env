# Cycle Analyst App - editable app configuration
# This file is loaded automatically by cycle_server.py and by systemd.
# Lines starting with '# KEY=' are available in the UI but disabled.


# Runtime
# Dossier des DB, sessions, profils, photos locales et etat runtime.
APP_VAR_DIR=var
# A activer surtout en WSGI/gunicorn. Avec cycle_server.py, le reader demarre deja.
# APP_START_READER=0

# GPS and map
# Port serie du GPS NMEA USB.
APP_GPS_PORT=/dev/ttyACM0
# Vitesse serie du GPS.
APP_GPS_BAUDRATE=9600
# Fichier .pmtiles offline servi par /tiles/basemap.pmtiles.
APP_PMTILES_PATH=/home/jeandard/Documents/tiles.pmtiles

# Solar and battery
# Puissance max panneaux utilisee pour l'estimation solaire.
APP_SOLAR_PANEL_MAX_W=590
# Latitude par defaut pour l'estimation solaire.
APP_SOLAR_LAT=48.8566
# Longitude par defaut pour l'estimation solaire.
APP_SOLAR_LON=2.3522
# Tension nominale batterie pour les calculs Wh.
APP_BATTERY_NOMINAL_VOLTAGE=48.1
# Fichier JSON optionnel de courbe voltage/SOC.
APP_BATTERY_DISCHARGE_CURVE_FILE=var/battery_curve_lg_mh1_from_trip.json

# INA228 solar sensor
# Mettre ina228 pour activer le capteur solaire I2C.
# APP_SOLAR_SENSOR=ina228
# Bus I2C du capteur INA228.
# APP_SOLAR_I2C_BUS=1
# Adresse INA228. Utiliser 0 pour probe 0x41, 0x44, 0x45.
# APP_SOLAR_I2C_ADDR=0x45
# Valeur du shunt INA228.
# APP_SOLAR_SHUNT_OHMS=0.0002
# Courant pleine echelle pour CURRENT_LSB.
# APP_SOLAR_MAX_AMPS=204.8
# Correction multiplicative du courant solaire.
# APP_SOLAR_CURRENT_GAIN=1.0
# Offset courant solaire en amperes.
# APP_SOLAR_CURRENT_OFFSET=0.0
# Zone morte des petits courants.
# APP_SOLAR_CURRENT_DEADBAND_A=0.15
# Active le lissage courant solaire: mediane courte + filtre adaptatif.
# APP_SOLAR_FILTER_ENABLED=true
# Temps de lissage normal en secondes. Plus grand = plus stable, plus lent.
# APP_SOLAR_FILTER_TAU_SECONDS=4.0
# Temps de lissage quand une vraie variation est detectee.
# APP_SOLAR_FILTER_FAST_TAU_SECONDS=0.8
# Nombre d'echantillons pour retirer les pics isoles.
# APP_SOLAR_FILTER_MEDIAN_WINDOW=5
# Ecart en amperes qui declenche le mode rapide.
# APP_SOLAR_FILTER_JUMP_THRESHOLD_A=2.5
# Zone morte appliquee apres filtrage.
# APP_SOLAR_FILTER_OUTPUT_DEADBAND_A=0.15
# Activer seulement si le courant solaire apparait avec le mauvais signe.
# APP_SOLAR_INVERT_SIGN=true

# Camera
# Commande de capture photo. {output} est remplace par le fichier JPEG.
APP_CAMERA_COMMAND=fswebcam -d /dev/video0 -q -S 60 --palette YUYV -r 640x480 --jpeg 85 --no-banner {output}

# Monitor sync
# ID unique envoye au monitor_server.
MONITOR_DEVICE_ID=sc-vehicule-1
# URL du monitor_server. Laisser vide seulement pour desactiver la synchronisation.
MONITOR_URL=http://91.134.243.157:8080
# Login Basic Auth du monitor_server.
MONITOR_USER=
# Mot de passe Basic Auth du monitor_server.
MONITOR_PASS=
# Nombre de lignes envoyees par paquet au monitor_server.
MONITOR_UPLOAD_CHUNK_SIZE=1000
