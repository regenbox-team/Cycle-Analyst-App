# Cycle Analyst App - editable app configuration
# Copy this file to cycle-analyst.env for a local install.
# The app also creates cycle-analyst.env automatically if it is missing.

# Runtime
APP_VAR_DIR=var
# APP_START_READER=0
# Split-service install:
# - cycle-recorder.service starts reader/GPS and writes DB + live metrics.
# - cycle-photo.service handles camera capture + photo upload retries.
# - cycle-analyst.service serves the UI and reads live metrics from files.
# APP_START_GPS=0
# APP_START_MONITOR=0
# APP_LIVE_STATE_FROM_FILES=1
# APP_SCHEDULE_PHOTOS=0
# APP_PHOTO_WORKER_INTERVAL_SECONDS=1
# APP_PHOTO_UPLOAD_RETRY_SECONDS=15

# GPS and map
APP_GPS_PORT=/dev/ttyACM0
APP_GPS_BAUDRATE=9600
# Leave empty until the offline map file is installed.
APP_PMTILES_PATH=

# Solar and battery
APP_SOLAR_PANEL_MAX_W=590
APP_SOLAR_LAT=48.8566
APP_SOLAR_LON=2.3522
APP_BATTERY_NOMINAL_VOLTAGE=48.1
APP_BATTERY_DISCHARGE_CURVE_FILE=var/battery_curve_lg_mh1_from_trip.json

# INA228 solar sensor
# APP_SOLAR_SENSOR=ina228
# APP_SOLAR_I2C_BUS=1
# APP_SOLAR_I2C_ADDR=0x45
# APP_SOLAR_SHUNT_OHMS=0.0002
# APP_SOLAR_MAX_AMPS=204.8
# APP_SOLAR_CURRENT_GAIN=1.0
# APP_SOLAR_CURRENT_OFFSET=0.0
# APP_SOLAR_CURRENT_DEADBAND_A=0.15
# APP_SOLAR_INVERT_SIGN=true

# Camera
APP_CAMERA_COMMAND=fswebcam -d /dev/video0 -q -S 10 --palette YUYV -r 640x480 --jpeg 70 --no-banner {output}

# Monitor sync
# Leave empty to use the Pi hostname automatically, for example sc-vehicule-5.
MONITOR_DEVICE_ID=
MONITOR_URL=http://91.134.243.157:8080
MONITOR_USER=
MONITOR_PASS=
MONITOR_UPLOAD_CHUNK_SIZE=1000
MONITOR_UPLOAD_CHUNK_MAX_BYTES=262144
MONITOR_UPLOAD_GZIP=1
MONITOR_RESPONSE_GZIP=1
MONITOR_AUTO_UPLOAD_SESSIONS=0
SUNTRIP_START_DATE=2026-05-04
SUNTRIP_DEVICE_ALIASES=
SUNTRIP_PHOTO_LIMIT=5000
